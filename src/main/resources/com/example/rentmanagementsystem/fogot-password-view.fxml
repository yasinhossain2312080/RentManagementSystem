<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #2C7A7B, #16353D);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentmanagementsystem.ForgotPasswordViewViewController">
   <children>
      <Label alignment="CENTER" layoutX="277.0" layoutY="60.0" prefHeight="46.0" prefWidth="412.0" style="-fx-text-fill: #F5F5F5;" text="RENT MANAGEMENT SYSTEM">
         <font>
            <Font name="Segoe UI Bold" size="23.0" />
         </font>
      </Label>
      <Label layoutX="411.0" layoutY="125.0" style="-fx-text-fill: #F5F5F5;" text="FORGOT PASSWORD">
         <font>
            <Font name="Segoe UI Bold" size="18.0" />
         </font>
      </Label>
      <Pane layoutX="232.0" layoutY="174.0" prefHeight="363.0" prefWidth="492.0" style="-fx-background-color: #0E2227; -fx-background-radius: 8;">
         <children>
            <Button layoutX="156.0" layoutY="221.0" mnemonicParsing="false" onAction="#sendVerificationCodeButtonOnAction" text="Send Verification Code">
               <font>
                  <Font name="Segoe UI Bold" size="17.0" />
               </font>
            </Button>
            <Button layoutX="201.0" layoutY="292.0" mnemonicParsing="false" onAction="#backToLoginPageButtonOnAction" text="Back to login page" />
            <TextField fx:id="enterEmailTextField" alignment="CENTER" layoutX="101.0" layoutY="47.0" prefHeight="46.0" prefWidth="315.0" promptText="Enter Email" />
            <TextField fx:id="enterPhoneNumberTextField" alignment="CENTER" layoutX="101.0" layoutY="136.0" prefHeight="46.0" prefWidth="315.0" promptText="Enter Phone Number" />
         </children>
      </Pane>
   </children>
</AnchorPane>
