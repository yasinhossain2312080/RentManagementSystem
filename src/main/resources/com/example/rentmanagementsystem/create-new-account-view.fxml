<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #2C7A7B, #16353D);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.rentmanagementsystem.CreateNewAccountViewController">
   <children>
      <Label alignment="CENTER" layoutX="301.0" layoutY="38.0" prefHeight="39.0" prefWidth="396.0" style="-fx-text-fill: #F5F5F5;" text="RENT MANAGEMENT SYSTEM">
         <font>
            <Font name="Segoe UI Bold" size="24.0" />
         </font>
      </Label>
      <Label alignment="CENTER" layoutX="406.0" layoutY="84.0" prefHeight="23.0" prefWidth="187.0" style="-fx-text-fill: #F5F5F5;" text="Create New Account">
         <font>
            <Font name="Segoe UI Bold" size="18.0" />
         </font>
      </Label>
      <Pane layoutX="210.0" layoutY="119.0" prefHeight="464.0" prefWidth="578.0" style="-fx-background-color: #0E2227; -fx-background-radius: 8;">
         <children>
            <Label layoutX="37.0" layoutY="14.0" text="User Name" textFill="WHITESMOKE" />
            <TextField fx:id="userNameTextField" alignment="CENTER" layoutX="38.0" layoutY="48.0" prefHeight="32.0" prefWidth="323.0" promptText="User Name" />
            <Label layoutX="38.0" layoutY="174.0" text="Email" textFill="WHITESMOKE" />
            <TextField fx:id="emailTextField" alignment="CENTER" layoutX="38.0" layoutY="208.0" prefHeight="32.0" prefWidth="323.0" promptText="Email" />
            <Label layoutX="38.0" layoutY="98.0" text="Phone Number" textFill="WHITESMOKE" />
            <TextField fx:id="phoneNumberTextField" alignment="CENTER" layoutX="38.0" layoutY="128.0" prefHeight="32.0" prefWidth="323.0" promptText="Phone Number " />
            <Label layoutX="52.0" layoutY="264.0" text="Password" textFill="WHITESMOKE" />
            <TextField fx:id="passwordTextField" alignment="CENTER" layoutX="52.0" layoutY="293.0" prefHeight="32.0" prefWidth="177.0" promptText="Password" />
            <Label layoutX="353.0" layoutY="265.0" text="Confirm Password" textFill="WHITESMOKE" />
            <TextField fx:id="confirmPasswordTextField" alignment="CENTER" layoutX="353.0" layoutY="294.0" prefHeight="32.0" prefWidth="177.0" promptText="Confirm Password" />
            <Button layoutX="207.0" layoutY="355.0" mnemonicParsing="false" onAction="#createNewAccountButtonOnAction" text="Create New Account">
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font>
            </Button>
            <Button layoutX="430.0" layoutY="414.0" mnemonicParsing="false" onAction="#backToLoginPageButtonOnAction" text="Back to login page">
               <font>
                  <Font name="Segoe UI Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </Pane>
   </children>
</AnchorPane>
